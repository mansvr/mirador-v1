{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "http://localhost:3001",
          "http://127.0.0.1:3000",
          "http://127.0.0.1:3001",
          "https://mirador.lat",
          "https://www.mirador.lat",
          "https://mirador.homes",
          "https://www.mirador.homes"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
