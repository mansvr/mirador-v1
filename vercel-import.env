# Mirador — import into Vercel: Project → Settings → Environment Variables → Import .env
# Production: use vercel.app URL until you switch SITE_URL to mirador.lat (see below).
# Preview: add the same keys for Preview (all branches) via Dashboard if CLI prompts for a branch.
#
# Dashboard embeds: https://<NEXT_PUBLIC_SITE_URL>/e/<sceneId>

# Required — canonical public URL (no trailing slash). Must match the host users open in the browser.
# Until mirador.lat is the canonical host: https://mirador-v1-six.vercel.app
# When DNS is live on mirador.lat: https://mirador.lat — then redeploy.
NEXT_PUBLIC_SITE_URL=https://mirador-v1-six.vercel.app

# Required for production splats hosted on Cloudflare R2 (replace with your pub-….r2.dev or custom R2 domain)
# Leave empty only if every scene uses same-origin paths like /best-splat_50000.sog in public/
NEXT_PUBLIC_R2_URL=https://pub-709488f795594fd1bbdf827d49a5ff63.r2.dev

# Optional — analytics (uncomment and fill to enable PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
