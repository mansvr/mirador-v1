# Mirador — import into Vercel: Project → Settings → Environment Variables → Import .env
# Production: canonical host (mirador.lat). Preview: see vercel-import-preview.env.
#
# Dashboard embeds: https://mirador.lat/e/<sceneId>

# Required — canonical public URL (no trailing slash). Used in embed snippets, OG, QR.
NEXT_PUBLIC_SITE_URL=https://mirador.lat

# Required for production splats hosted on Cloudflare R2 (replace with your pub-….r2.dev or custom R2 domain)
# Leave empty only if every scene uses same-origin paths like /best-splat_50000.sog in public/
NEXT_PUBLIC_R2_URL=https://pub-709488f795594fd1bbdf827d49a5ff63.r2.dev

# Analytics — set in Vercel dashboard (do not commit real key; see .env.local)
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_IN_VERCEL_DASHBOARD
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
