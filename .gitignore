# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# graphify (local code graph; optional in CI)
/graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts

# Mirador — splat assets in scenes/ (large binaries, usually R2-only)
scenes/**/*.sog
scenes/**/*.spz
scenes/**/*.ply
scenes/**/*.splat
scenes/**/*.ksplat
scenes/**/*.webp
scenes/**/*.png

# Mirador — large splats in public/ (local hard link; do not commit)
public/**/*.sog
public/**/*.spz
public/**/*.ply

# Keep scene.json metadata files in git
!scenes/**/scene.json
