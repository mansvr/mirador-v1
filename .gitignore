# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Mirador — splat assets (large binary files, stored in R2)
scenes/**/*.sog
scenes/**/*.spz
scenes/**/*.ply
scenes/**/*.splat
scenes/**/*.ksplat

# Mirador — generated thumbnails (tracked in R2, not git)
scenes/**/*.webp
scenes/**/*.png

# Keep scene.json metadata files in git
!scenes/**/scene.json
